---
import '../styles/global.css';
import Atmosphere from '../components/Atmosphere.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const pageTitle = `${title} · UNSIGNED. Hannover`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // Verhindert Flackern: gespeicherte Design-Variante vor dem ersten Rendern setzen.
      try {
        document.documentElement.setAttribute('data-variant', localStorage.getItem('unsigned-variant') || 'signal');
      } catch (e) {
        document.documentElement.setAttribute('data-variant', 'signal');
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="UNSIGNED. Hannover" />

    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <Atmosphere />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
