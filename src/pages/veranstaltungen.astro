---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import EventCard from '../components/EventCard.astro';

const now = new Date();
const visibleEvents = (await getCollection('events')).filter((event) => !event.data.hidden);

const upcoming = visibleEvents
  .filter((event) => event.data.date >= now)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const past = visibleEvents
  .filter((event) => event.data.date < now)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
  title="Veranstaltungen"
  description="Alle kommenden und vergangenen Veranstaltungen von UNSIGNED. Hannover."
>
  <section class="band">
    <div class="mx-auto max-w-5xl px-4 py-16">
      <h1 class="brand-heading text-3xl sm:text-4xl">Veranstaltungen</h1>
      <p class="mt-3 opacity-90">Alle kommenden Termine – und ein Rückblick auf vergangene Events.</p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-16">
    <h2 class="brand-heading text-2xl text-neutral-900">Kommende Termine</h2>
    <div class="mt-6 space-y-4">
      {
        upcoming.length > 0 ? (
          upcoming.map((event) => (
            <EventCard
              title={event.data.title}
              date={event.data.date}
              location={event.data.location}
              description={event.data.description}
              ticketUrl={event.data.ticketUrl}
            />
          ))
        ) : (
          <p class="text-neutral-500">Aktuell keine Termine geplant – schau bald wieder vorbei.</p>
        )
      }
    </div>
  </section>

  {
    past.length > 0 && (
      <section class="mx-auto max-w-5xl px-4 pb-20">
        <h2 class="brand-heading text-2xl text-neutral-900">Archiv</h2>
        <p class="mt-1 text-sm text-neutral-500">Vergangene Veranstaltungen zum Nachschauen.</p>
        <div class="mt-6 space-y-4 opacity-80">
          {past.map((event) => (
            <EventCard
              title={event.data.title}
              date={event.data.date}
              location={event.data.location}
              description={event.data.description}
            />
          ))}
        </div>
      </section>
    )
  }
</Layout>
