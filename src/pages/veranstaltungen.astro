---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import EventRow from '../components/EventRow.astro';
import EventRowEditorial from '../components/EventRowEditorial.astro';

const now = new Date();
const visibleEvents = (await getCollection('events')).filter((event) => !event.data.hidden);

const upcoming = visibleEvents
  .filter((event) => event.data.date >= now)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const past = visibleEvents
  .filter((event) => event.data.date < now)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
  title="Veranstaltungen"
  description="Alle kommenden und vergangenen Veranstaltungen von UNSIGNED. Hannover."
>
  <section class="hero page-hero">
    <h1 class="hero-wordmark glitch" data-text="VERANSTALTUNGEN">VERANSTALTUNGEN<span class="dot">.</span></h1>
    <p class="hero-sub">Alle kommenden Termine — und ein Rückblick auf vergangene Übertragungen.</p>
  </section>

  <section class="plate">
    <div class="v-signal">
      <div class="module-label"><span class="idx">MODULE_02</span> ANSTEHENDE ÜBERTRAGUNGEN</div>
      {
        upcoming.length > 0 ? (
          upcoming.map((event, i) => (
            <EventRow
              index={i + 1}
              title={event.data.title}
              date={event.data.date}
              location={event.data.location}
              description={event.data.description}
              ticketUrl={event.data.ticketUrl}
            />
          ))
        ) : (
          <p class="prose">Aktuell keine Termine geplant — schau bald wieder vorbei.</p>
        )
      }
    </div>

    <div class="v-editorial">
      <p class="ed-eyebrow">Spielplan</p>
      <h2 class="ed-h2" style="margin-bottom:32px;">Kommende Termine</h2>
      <div class="ed-events">
        {
          upcoming.length > 0 ? (
            upcoming.map((event) => (
              <EventRowEditorial
                title={event.data.title}
                date={event.data.date}
                location={event.data.location}
                description={event.data.description}
                ticketUrl={event.data.ticketUrl}
              />
            ))
          ) : (
            <p class="prose">Aktuell keine Termine geplant — schau bald wieder vorbei.</p>
          )
        }
      </div>
    </div>
  </section>

  {
    past.length > 0 && (
      <section class="plate tinted">
        <div class="v-signal">
          <div class="module-label"><span class="idx">MODULE_02B</span> ARCHIV</div>
          {past.map((event, i) => (
            <EventRow
              index={100 + i}
              title={event.data.title}
              date={event.data.date}
              location={event.data.location}
              description={event.data.description}
              archived
            />
          ))}
        </div>

        <div class="v-editorial">
          <p class="ed-eyebrow">Rückblick</p>
          <h2 class="ed-h2" style="margin-bottom:32px;">Archiv</h2>
          <div class="ed-events">
            {past.map((event) => (
              <EventRowEditorial
                title={event.data.title}
                date={event.data.date}
                location={event.data.location}
                description={event.data.description}
                archived
              />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Layout>
