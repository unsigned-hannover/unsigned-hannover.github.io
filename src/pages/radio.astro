---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import RadioPlayer from '../components/RadioPlayer.astro';

const episodes = (await getCollection('radio')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
  title="Radio"
  description="UNSIGNED.RADIO – zweiwöchentlicher Podcast mit lokalen Artists aus der Hannoveraner Electronic-Szene."
>
  <section class="hero page-hero">
    <h1 class="hero-wordmark glitch" data-text="UNSIGNED.RADIO">UNSIGNED<span class="dot">.</span>RADIO</h1>
    <p class="hero-sub">
      Unser zweiwöchentlicher Podcast: lokale DJs und Artists aus der Hannoveraner Electronic-Szene, live gemixt.
    </p>
  </section>

  <section class="plate">
    <div class="module-label"><span class="idx">MODULE_03</span> ARCHIV — ALLE FOLGEN</div>
    <div style="display:flex; flex-direction:column; gap:32px;">
      {
        episodes.map((episode, i) => (
          <div>
            <RadioPlayer
              title={episode.data.title}
              soundcloudUrl={episode.data.soundcloudUrl}
              episodeNumber={`EP.${String(episodes.length - i).padStart(2, '0')}`}
            />
            {episode.data.description && <p class="prose" style="margin-top:12px;">{episode.data.description}</p>}
          </div>
        ))
      }
    </div>
  </section>
</Layout>
