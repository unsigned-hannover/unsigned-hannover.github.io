---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import RadioEmbed from '../components/RadioEmbed.astro';

const episodes = (await getCollection('radio')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
  title="Radio"
  description="UNSIGNED.RADIO – zweiwöchentlicher Podcast mit lokalen Artists aus der Hannoveraner Electronic-Szene."
>
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-extrabold text-white sm:text-4xl">UNSIGNED.RADIO</h1>
    <p class="mt-3 text-white/70">
      Unser zweiwöchentlicher Podcast: lokale DJs und Artists aus der Hannoveraner Electronic-Szene, live gemixt.
    </p>

    <div class="mt-10 space-y-4">
      {
        episodes.map((episode) => (
          <div>
            <RadioEmbed title={episode.data.title} soundcloudUrl={episode.data.soundcloudUrl} />
            {episode.data.description && <p class="mt-2 px-1 text-sm text-white/60">{episode.data.description}</p>}
          </div>
        ))
      }
    </div>
  </section>
</Layout>
