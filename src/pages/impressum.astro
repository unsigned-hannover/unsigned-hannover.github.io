---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Impressum" description="Impressum des Kulturverein UNSIGNED. e.V., Hannover.">
  <section class="hero page-hero">
    <h1 class="hero-wordmark glitch" data-text="IMPRESSUM">IMPRESSUM<span class="dot">.</span></h1>
  </section>

  <section class="plate">
    <div class="prose" style="display:flex; flex-direction:column; gap:22px; max-width:56ch;">
      <div>
        <p style="color:var(--color-fg); font-weight:700;">Kulturverein UNSIGNED. e.V.</p>
        <p>Ricklinger Stadtweg 33</p>
        <p>30459 Hannover</p>
      </div>

      <div>
        <p style="color:var(--color-fg); font-weight:700;">Vertreten durch</p>
        <p>Leonhard Wolters (1. Vorsitz)</p>
        <p>Moritz Wegener (2. Vorsitz)</p>
      </div>

      <div>
        <p style="color:var(--color-fg); font-weight:700;">Kontakt</p>
        <p>E-Mail: <a href="mailto:unsignedhannover@gmail.com" style="color:var(--color-brand);">unsignedhannover@gmail.com</a></p>
        <p>Website: unsignedhannover.com</p>
      </div>

      <div>
        <p style="color:var(--color-fg); font-weight:700;">Registereintrag</p>
        <p>Eingetragen im Vereinsregister</p>
        <p>Registergericht: Amtsgericht Hannover</p>
        <p>Registernummer: VR203971</p>
      </div>

      <div>
        <p style="color:var(--color-fg); font-weight:700;">Umsatzsteuer-ID</p>
        <p>DE 25/206/15022</p>
      </div>

      <p style="font-size:11px;">
        Rechtstext-Prüfung: Diese Angaben wurden 1:1 vom bisherigen Impressum übernommen. Bitte vor Go-Live vom Vorstand
        final gegenlesen lassen.
      </p>
    </div>
  </section>
</Layout>
