---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Impressum" description="Impressum des Kulturverein UNSIGNED. e.V., Hannover.">
  <section class="band">
    <div class="mx-auto max-w-2xl px-4 py-12">
      <h1 class="brand-heading text-3xl">Impressum</h1>
    </div>
  </section>

  <section class="mx-auto max-w-2xl px-4 py-16">
    <div class="space-y-6 text-neutral-700">
      <div>
        <p class="font-bold text-neutral-900">Kulturverein UNSIGNED. e.V.</p>
        <p>Ricklinger Stadtweg 33</p>
        <p>30459 Hannover</p>
      </div>

      <div>
        <p class="font-bold text-neutral-900">Vertreten durch</p>
        <p>Leonhard Wolters (1. Vorsitz)</p>
        <p>Moritz Wegener (2. Vorsitz)</p>
      </div>

      <div>
        <p class="font-bold text-neutral-900">Kontakt</p>
        <p>
          E-Mail: <a href="mailto:unsignedhannover@gmail.com" class="text-brand hover:text-brand-dark">unsignedhannover@gmail.com</a>
        </p>
        <p>Website: unsignedhannover.com</p>
      </div>

      <div>
        <p class="font-bold text-neutral-900">Registereintrag</p>
        <p>Eingetragen im Vereinsregister</p>
        <p>Registergericht: Amtsgericht Hannover</p>
        <p>Registernummer: VR203971</p>
      </div>

      <div>
        <p class="font-bold text-neutral-900">Umsatzsteuer-ID</p>
        <p>DE 25/206/15022</p>
      </div>

      <p class="text-sm text-neutral-400">
        Rechtstext-Prüfung: Diese Angaben wurden 1:1 vom bisherigen Impressum übernommen. Bitte vor Go-Live vom
        Vorstand final gegenlesen lassen.
      </p>
    </div>
  </section>
</Layout>
