---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import EventRow from '../components/EventRow.astro';
import EventRowEditorial from '../components/EventRowEditorial.astro';
import RadioPlayer from '../components/RadioPlayer.astro';
import RadioEditorial from '../components/RadioEditorial.astro';
import HeroEditorial from '../components/HeroEditorial.astro';
import StatsBlock from '../components/StatsBlock.astro';
import ContactForm from '../components/ContactForm.astro';
import { getSets } from '../lib/radio';

const now = new Date();
const upcomingEvents = (await getCollection('events'))
  .filter((event) => !event.data.hidden && event.data.date >= now)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .slice(0, 5);

const [latestEpisode] = await getSets();
---

<Layout
  title="Start"
  description="UNSIGNED. ist ein Kulturverein aus Hannover für elektronische Musik: Events, Podcast und eine Community zum Mitmachen."
>
  <!-- ============ HERO ============ -->
  <section class="hero v-glitch">
    <div class="rail-left">TECH HOUSE <b>//</b> TECHNO — HANNOVER, DE <b>///</b> OPEN DECKS — BAR NIGHTS — DAY PARTIES</div>

    <div class="rec"><span class="flicker-dot">●</span> HANNOVER — SEIT 2023</div>

    <h1 class="hero-wordmark glitch" data-text="UNSIGNED.">UNSIGNED<span class="dot">.</span></h1>

    <div class="hero-panel" aria-hidden="true"></div>

    <p class="hero-sub">
      <span class="tag">KULTURVEREIN UNSIGNED. e.V.</span>
      Ein gemeinnütziger Kulturverein für elektronische Musik aus Hannover — Open Decks, Bar Nights, Tagesveranstaltungen.
      Kein Line-up-Gatekeeping, keine Attitüde. Nur Boxen, Platten und Leute, die auflegen wollen.
    </p>

    <div class="hero-coords">
      52.3759° N / 9.7320° E<br />
      <b>PLATZBAR</b> — HANNOVER
    </div>

    <div class="scrollcue"><span>↓</span> SCROLLEN</div>
  </section>

  <div class="v-editorial">
    <HeroEditorial />
  </div>

  <!-- ============ STATS (nur Glitch – Editorial hat die Leiste im Hero) ============ -->
  <section class="plate tinted v-glitch">
    <div class="module-label">IN ZAHLEN</div>
    <StatsBlock />
  </section>

  <!-- ============ TERMINE ============ -->
  <section class="plate" id="termine">
    <div class="v-glitch">
      <div class="module-label">KOMMENDE TERMINE</div>
      {
        upcomingEvents.length > 0 ? (
          upcomingEvents.map((event, i) => (
            <EventRow
              title={event.data.title}
              date={event.data.date}
              location={event.data.location}
              description={event.data.description}
              ticketUrl={event.data.ticketUrl}
            />
          ))
        ) : (
          <p class="prose">Aktuell keine Termine geplant — schau bald wieder vorbei.</p>
        )
      }
    </div>

    <div class="v-editorial">
      <div class="ed-head-row">
        <div>
          <p class="ed-eyebrow">Spielplan</p>
          <h2 class="ed-h2">Termine</h2>
        </div>
        <a href="/veranstaltungen/" class="ed-btn ed-btn-ghost">Alle Termine →</a>
      </div>
      <div class="ed-events">
        {
          upcomingEvents.length > 0 ? (
            upcomingEvents.map((event) => (
              <EventRowEditorial
                title={event.data.title}
                date={event.data.date}
                location={event.data.location}
                description={event.data.description}
                ticketUrl={event.data.ticketUrl}
              />
            ))
          ) : (
            <p class="prose">Aktuell keine Termine geplant — schau bald wieder vorbei.</p>
          )
        }
      </div>
    </div>

    <p class="prose v-glitch" style="margin-top:22px;">
      Alle <a href="/veranstaltungen/" style="color:var(--color-brand);">Veranstaltungen im Archiv →</a> · Announcements auch auf
      <a href="https://www.instagram.com/unsigned.hannover/" style="color:var(--color-brand);">Instagram</a> und im
      <a href="https://chat.whatsapp.com/J6WfW29a2Uc58JfGyaK2Vr" target="_blank" rel="noopener noreferrer" style="color:var(--color-brand);">WhatsApp-Kanal</a>.
    </p>
  </section>

  <!-- ============ RADIO ============ -->
  <section class="plate tinted">
    <div class="v-glitch">
      <div class="module-label">RADIO</div>
      <div class="radio-grid">
        <div>
          <h2 class="radio-head glitch" data-text="UNSIGNED.RADIO">UNSIGNED<span class="dot">.</span>RADIO</h2>
          <p class="prose" style="margin-top:22px;">
            Unser zweiwöchentlicher DJ-Podcast — gehostet auf SoundCloud. Von Bedroom-Mixes bis floor-erprobten Sets,
            aufgenommen von den Leuten, die bei uns auflegen. Kein Filter, kein Gatekeeping.
          </p>
          <div class="onair"><span class="flicker-dot">●</span> NEUE FOLGE ALLE 2 WOCHEN</div>
          <p style="margin-top:20px;"><a href="/radio/" style="color:var(--color-brand); font-size:12px; letter-spacing:.15em;">ALLE SETS →</a></p>
        </div>

        {latestEpisode && <RadioPlayer title={latestEpisode.data.title} soundcloudUrl={latestEpisode.data.soundcloudUrl} episodeNumber="NEUESTES SET" />}
      </div>
    </div>

    <div class="v-editorial">
      {latestEpisode && <RadioEditorial title={latestEpisode.data.title} soundcloudUrl={latestEpisode.data.soundcloudUrl} cover={latestEpisode.data.cover} />}
    </div>
  </section>

  <!-- ============ CTA MITGLIED ============ -->
  <section class="plate cta-plate">
    <div class="module-label">MITGLIEDSCHAFT</div>
    <h2 class="v-glitch">WERDE MITGLIED<span class="dot">.</span></h2>
    <h2 class="v-editorial">Lust mit<br />zu machen<span class="dot">?</span></h2>
    <p>
      Kulturverein UNSIGNED. e.V. lebt von seinen Mitgliedern — Zugang zu Open Decks, Mitsprache bei der Programmplanung
      und eine Crew, die wirklich zeigt. Wir sind gemeinnützig; wir brauchen mehr von euch.
    </p>
    <a class="cta-btn" href="/kulturverein/#mitglied-werden">→ MITGLIED WERDEN</a>
  </section>

  <!-- ============ KONTAKT ============ -->
  <section class="plate" id="kontakt">
    <div class="module-label">KONTAKT</div>
    <ContactForm formType="contact" heading="Schreib uns" />
  </section>
</Layout>
