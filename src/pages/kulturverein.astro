---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Layout
  title="Kulturverein"
  description="Kulturverein UNSIGNED. e.V. – gemeinnütziger Verein für elektronische Musik in Hannover. Werde Mitglied."
>
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-extrabold text-white sm:text-4xl">Der Kulturverein</h1>
    <p class="mt-4 text-white/80">
      UNSIGNED. ist ein gemeinnütziger Kulturverein aus Hannover mit Fokus auf elektronische Musik. Wir wollen einer
      interessierten Community eine Plattform bieten, um sich zu vernetzen und auszutauschen.
    </p>

    <h2 class="mt-10 text-xl font-bold text-white">Was wir machen</h2>
    <ul class="mt-4 space-y-2 text-white/80">
      <li>· Regelmäßige Open Decks und Bar Nights, meist in der Platzbar</li>
      <li>· Größere Tagesveranstaltungen mit DJ-Line-ups</li>
      <li>· UNSIGNED.RADIO – unser zweiwöchentlicher Podcast mit lokalen Artists</li>
    </ul>

    <h2 class="mt-10 text-xl font-bold text-white">Vorstand</h2>
    <ul class="mt-4 space-y-1 text-white/80">
      <li>Leonhard Wolters – 1. Vorsitz</li>
      <li>Moritz Wegener – 2. Vorsitz</li>
    </ul>

    <div class="mt-12" id="mitglied-werden">
      <h2 class="text-xl font-bold text-white">Mitglied werden</h2>
      <p class="mt-2 text-white/70">
        Wir freuen uns über ordentliche Mitglieder, die sich aktiv einbringen möchten, und fördernde Mitglieder, die
        uns unterstützen.
      </p>
      <div class="mt-6">
        <ContactForm formType="membership" heading="Mitgliedsantrag" intro="Wir melden uns bei dir mit den nächsten Schritten." />
      </div>
    </div>
  </section>
</Layout>
