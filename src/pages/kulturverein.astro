---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Layout
  title="Kulturverein"
  description="Kulturverein UNSIGNED. e.V. – gemeinnütziger Verein für elektronische Musik in Hannover. Werde Mitglied."
>
  <section class="hero page-hero">
    <h1 class="hero-wordmark glitch" data-text="DER VEREIN">DER VEREIN<span class="dot">.</span></h1>
    <p class="hero-sub">
      UNSIGNED. ist ein gemeinnütziger Kulturverein aus Hannover mit Fokus auf elektronische Musik. Wir wollen einer
      interessierten Community eine Plattform bieten, um sich zu vernetzen und auszutauschen.
    </p>
  </section>

  <section class="plate">
    <div class="module-label">WAS WIR MACHEN</div>
    <ul class="prose" style="list-style:none; padding:0; display:flex; flex-direction:column; gap:10px;">
      <li>· Regelmäßige Open Decks und Bar Nights, meist in der Platzbar</li>
      <li>· Größere Tagesveranstaltungen mit DJ-Line-ups</li>
      <li>· UNSIGNED.RADIO — unser zweiwöchentlicher Podcast mit lokalen Artists</li>
    </ul>
  </section>

  <section class="plate">
    <div class="module-label">VORSTAND</div>
    <ul class="prose" style="list-style:none; padding:0; display:flex; flex-direction:column; gap:6px;">
      <li>Leonhard Wolters — 1. Vorsitz</li>
      <li>Moritz Wegener — 2. Vorsitz</li>
    </ul>
  </section>

  <section class="plate" id="mitglied-werden">
    <div class="module-label">MITGLIED WERDEN</div>
    <p class="prose" style="margin-bottom:22px;">
      Wir freuen uns über ordentliche Mitglieder, die sich aktiv einbringen möchten, und fördernde Mitglieder, die uns
      unterstützen.
    </p>
    <ContactForm formType="membership" heading="Mitgliedsantrag" intro="Wir melden uns bei dir mit den nächsten Schritten." />
  </section>
</Layout>
