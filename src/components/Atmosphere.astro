---
// Fixe Deko-Layer (Rauschen/Scanlines/Vignette/Glitch-Burst) + Live-Uhr. Rein optisch, kein Tracking.
---

<svg width="0" height="0" style="position:absolute">
  <defs>
    <filter id="turb">
      <feTurbulence type="fractalNoise" baseFrequency="0.012 0.04" numOctaves="2" seed="7" result="n">
        <animate attributeName="baseFrequency" values="0.012 0.04;0.02 0.06;0.012 0.04" dur="14s" repeatCount="indefinite" />
      </feTurbulence>
      <feDisplacementMap in="SourceGraphic" in2="n" scale="34" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </defs>
</svg>

<canvas id="noiseCanvas"></canvas>
<div class="scanlines"></div>
<div class="vignette"></div>
<div class="tracking-glitch"></div>

<script>
  (function () {
    'use strict';
    const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const canvas = document.getElementById('noiseCanvas') as HTMLCanvasElement | null;
    const ctx = canvas?.getContext('2d', { alpha: true });
    let w = 0;
    let h = 0;
    function resizeNoise() {
      if (!canvas) return;
      w = canvas.width = Math.max(64, Math.floor(window.innerWidth / 4));
      h = canvas.height = Math.max(48, Math.floor(window.innerHeight / 4));
    }
    resizeNoise();
    window.addEventListener('resize', resizeNoise);

    function drawNoise() {
      if (!ctx) return;
      const img = ctx.createImageData(w, h);
      const buf = img.data;
      for (let i = 0; i < buf.length; i += 4) {
        const v = (Math.random() * 255) | 0;
        buf[i] = v;
        buf[i + 1] = v;
        buf[i + 2] = v;
        buf[i + 3] = 22;
      }
      ctx.putImageData(img, 0, 0);
    }

    let lastNoise = 0;
    function noiseLoop(t: number) {
      if (t - lastNoise > 100) {
        drawNoise();
        lastNoise = t;
      }
      requestAnimationFrame(noiseLoop);
    }
    if (!reduceMotion) {
      requestAnimationFrame(noiseLoop);
    } else {
      drawNoise();
    }
  })();
</script>
