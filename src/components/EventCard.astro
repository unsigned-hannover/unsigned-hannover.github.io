---
interface Props {
  title: string;
  date: Date;
  location: string;
  description?: string;
  ticketUrl?: string;
}

const { title, date, location, description, ticketUrl } = Astro.props;

const day = date.toLocaleDateString('de-DE', { day: '2-digit' });
const month = date.toLocaleDateString('de-DE', { month: 'short' });
const time = date.toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' });

function toIcsDate(d: Date) {
  return d.toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z';
}

const icsHref = `data:text/calendar;charset=utf-8,${encodeURIComponent(
  [
    'BEGIN:VCALENDAR',
    'VERSION:2.0',
    'BEGIN:VEVENT',
    `SUMMARY:${title}`,
    `DTSTART:${toIcsDate(date)}`,
    `LOCATION:${location}`,
    `DESCRIPTION:${description ?? ''}`,
    'END:VEVENT',
    'END:VCALENDAR',
  ].join('\r\n')
)}`;
---

<article class="flex gap-4 rounded-xl border border-white/10 bg-neutral-900 p-4 sm:p-5">
  <div class="flex w-14 flex-none flex-col items-center justify-center rounded-lg bg-brand/15 py-2 text-brand">
    <span class="text-xl font-extrabold leading-none">{day}</span>
    <span class="text-xs font-bold uppercase leading-none">{month}</span>
  </div>

  <div class="min-w-0 flex-1">
    <h3 class="truncate text-lg font-bold text-white">{title}</h3>
    <p class="text-sm text-white/60">{time} Uhr · {location}</p>
    {description && <p class="mt-2 text-sm text-white/70">{description}</p>}

    <div class="mt-3 flex flex-wrap gap-3 text-sm font-semibold">
      {
        ticketUrl && (
          <a href={ticketUrl} target="_blank" rel="noopener noreferrer" class="text-brand hover:text-brand-light">
            Tickets →
          </a>
        )
      }
      <a href={icsHref} download={`${title}.ics`} class="text-white/60 hover:text-white">
        Zum Kalender hinzufügen
      </a>
    </div>
  </div>
</article>
