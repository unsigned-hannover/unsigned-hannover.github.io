---
interface Props {
  title: string;
  date: Date;
  location: string;
  description?: string;
  ticketUrl?: string;
}

const { title, date, location, description, ticketUrl } = Astro.props;

const day = date.toLocaleDateString('de-DE', { day: '2-digit' });
const month = date.toLocaleDateString('de-DE', { month: 'short' });
const time = date.toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' });

function toIcsDate(d: Date) {
  return d.toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z';
}

const icsHref = `data:text/calendar;charset=utf-8,${encodeURIComponent(
  [
    'BEGIN:VCALENDAR',
    'VERSION:2.0',
    'BEGIN:VEVENT',
    `SUMMARY:${title}`,
    `DTSTART:${toIcsDate(date)}`,
    `LOCATION:${location}`,
    `DESCRIPTION:${description ?? ''}`,
    'END:VEVENT',
    'END:VCALENDAR',
  ].join('\r\n')
)}`;
---

<article class="card flex gap-4 bg-white p-4 sm:p-5">
  <div class="flex w-14 flex-none flex-col items-center justify-center bg-brand/10 py-2 text-brand">
    <span class="label-mono text-xl font-extrabold leading-none">{day}</span>
    <span class="label-mono text-xs font-bold uppercase leading-none">{month}</span>
  </div>

  <div class="min-w-0 flex-1">
    <h3 class="truncate text-lg font-bold text-neutral-900">{title}</h3>
    <p class="text-sm text-neutral-500">{time} Uhr · {location}</p>
    {description && <p class="mt-2 text-sm text-neutral-600">{description}</p>}

    <div class="mt-3 flex flex-wrap gap-3 text-sm font-semibold">
      {
        ticketUrl && (
          <a href={ticketUrl} target="_blank" rel="noopener noreferrer" class="text-brand hover:text-brand-dark">
            Tickets →
          </a>
        )
      }
      <a href={icsHref} download={`${title}.ics`} class="text-neutral-500 hover:text-neutral-800">
        Zum Kalender hinzufügen
      </a>
    </div>
  </div>
</article>
