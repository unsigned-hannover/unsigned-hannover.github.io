---
interface Props {
  title: string;
  date: Date;
  location: string;
  description?: string;
  ticketUrl?: string;
  archived?: boolean;
}

const { title, date, location, description, ticketUrl, archived = false } = Astro.props;

// Immer in Berliner Zeit formatieren, der Build läuft auf GitHub Actions in UTC.
const timeZone = 'Europe/Berlin';
const day = date.toLocaleDateString('de-DE', { day: '2-digit', timeZone });
const month = date.toLocaleDateString('de-DE', { month: '2-digit', timeZone });
const time = date.toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit', timeZone });

function toIcsDate(d: Date) {
  return d.toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z';
}

const icsHref = `data:text/calendar;charset=utf-8,${encodeURIComponent(
  [
    'BEGIN:VCALENDAR',
    'VERSION:2.0',
    'BEGIN:VEVENT',
    `SUMMARY:${title}`,
    `DTSTART:${toIcsDate(date)}`,
    `LOCATION:${location}`,
    `DESCRIPTION:${description ?? ''}`,
    'END:VEVENT',
    'END:VCALENDAR',
  ].join('\r\n')
)}`;
---

<div class={`evt-row ${archived ? 'is-archived' : ''}`}>
  <div class="evt-idx">
    <span class="dt">{day}.{month}</span>
    <span class="tm">{time}</span>
  </div>

  <div>
    <div class="evt-title glitch" data-text={title}>{title}</div>
    <div class="evt-venue">
      <b>{location}</b>
    </div>
    {description && <p class="evt-desc">{description}</p>}
  </div>

  <div class="evt-actions">
    {archived ? (
      <span class="evt-cta" style="opacity:.5;">ARCHIVIERT</span>
    ) : (
      <a class="evt-cta" href={ticketUrl ?? '#termine'}>{ticketUrl ? 'TICKETS →' : 'INFO →'}</a>
    )}
    <a class="evt-ics" href={icsHref} download={`${title}.ics`}>+ Zum Kalender hinzufügen</a>
  </div>
</div>
