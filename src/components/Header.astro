---
const nav = [
  { href: '/', label: 'Start' },
  { href: '/veranstaltungen/', label: 'Veranstaltungen' },
  { href: '/radio/', label: 'Radio' },
  { href: '/kulturverein/', label: 'Kulturverein' },
  { href: '/mitmachen/', label: 'Mitmachen' },
];
const currentPath = Astro.url.pathname;

const variants = [
  { value: 'signal', label: 'Signal' },
  { value: 'editorial', label: 'Editorial' },
];
---

<nav class="site-nav">
  <a href="/" class="logo">
    UNSIGNED<span class="dot">.</span>
  </a>

  <div class="nav-links">
    {
      nav.map((item) => (
        <a href={item.href} class={currentPath === item.href ? 'is-active' : ''}>
          {item.label}
        </a>
      ))
    }
  </div>

  <div class="clock"><span class="flicker-dot">●</span><span id="clock">00:00:00</span></div>

  <div class="variant-switch" id="variant-switch" title="Design-Variante (temporär)">
    {
      variants.map((v) => (
        <button type="button" data-variant-value={v.value}>
          {v.label}
        </button>
      ))
    }
  </div>

  <button type="button" class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="nav-mobile">
    MENU
  </button>
</nav>

<div class="nav-mobile" id="nav-mobile" hidden>
  {
    nav.map((item) => (
      <a href={item.href} class={currentPath === item.href ? 'is-active' : ''}>
        {item.label}
      </a>
    ))
  }
</div>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-mobile');
  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.hidden;
    if (menu) menu.hidden = isOpen;
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });

  const clockEl = document.getElementById('clock');
  function tick() {
    const d = new Date();
    const p = (n: number) => (n < 10 ? '0' : '') + n;
    if (clockEl) clockEl.textContent = `${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`;
  }
  tick();
  setInterval(tick, 1000);

  function markCurrent() {
    const current = document.documentElement.getAttribute('data-variant') || 'signal';
    document.querySelectorAll<HTMLButtonElement>('[data-variant-value]').forEach((btn) => {
      btn.classList.toggle('is-current', btn.dataset.variantValue === current);
    });
  }
  document.querySelectorAll<HTMLButtonElement>('[data-variant-value]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const value = btn.dataset.variantValue!;
      document.documentElement.setAttribute('data-variant', value);
      try {
        localStorage.setItem('unsigned-variant', value);
      } catch {}
      markCurrent();
    });
  });
  markCurrent();
</script>
