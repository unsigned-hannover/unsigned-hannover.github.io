---
const nav = [
  { href: "/", label: "Start" },
  { href: "/radio/", label: "Radio" },
  { href: "/kulturverein/", label: "Kulturverein" },
];
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-neutral-950/90 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
    <a href="/" class="text-lg font-extrabold tracking-tight text-white">
      UNSIGNED<span class="text-brand">.</span>
    </a>

    <nav class="hidden gap-6 text-sm font-semibold sm:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class={`transition-colors hover:text-brand ${
              currentPath === item.href ? "text-brand" : "text-white"
            }`}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <details class="relative sm:hidden">
      <summary class="cursor-pointer list-none text-white">
        <span class="sr-only">Menü</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </summary>
      <nav class="absolute right-0 mt-3 flex w-44 flex-col gap-1 rounded-lg border border-white/10 bg-neutral-900 p-2 text-sm font-semibold shadow-xl">
        {
          nav.map((item) => (
            <a href={item.href} class="rounded-md px-3 py-2 text-white hover:bg-white/5 hover:text-brand">
              {item.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>
