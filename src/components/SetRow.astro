---
// Ein Set in der Archivliste. Gleiches Markup für beide Design-Varianten, Unterschiede nur im CSS.
// DSGVO: Cover liegt lokal, der SoundCloud-Player wird erst nach Klick auf "Abspielen" geladen.
import { embedSrc, formatSetDate, type RadioSet } from '../lib/radio';

interface Props {
  set: RadioSet;
}

const { title, date, duration, cover, genres, soundcloudUrl } = Astro.props.set.data;
---

<article class="set-row" data-embed-src={embedSrc(soundcloudUrl)}>
  <img class="set-cover" src={cover ?? '/img/radio-placeholder.jpg'} alt="" width="500" height="500" loading="lazy" decoding="async" />

  <div class="set-body">
    <div class="set-meta">
      {formatSetDate(date)}{duration && ` · ${duration}`}
    </div>
    <h3 class="set-title">{title}</h3>
    {
      genres.length > 0 && (
        <div class="ed-tags set-genres">
          {genres.map((genre) => (
            <span class="ed-tag">{genre}</span>
          ))}
        </div>
      )
    }
  </div>

  <div class="set-actions">
    <button type="button" class="set-play" aria-label={`${title} laden und abspielen`}>▶ Abspielen</button>
    <a class="set-link" href={soundcloudUrl} target="_blank" rel="noopener noreferrer">SoundCloud ↗</a>
  </div>

  <div class="set-frame" hidden></div>
</article>

<script>
  // Ein Listener für alle Zeilen; es spielt immer nur ein Set gleichzeitig.
  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.set-play');
    const row = button?.closest<HTMLElement>('.set-row');
    const frame = row?.querySelector<HTMLElement>('.set-frame');
    if (!row || !frame || !row.dataset.embedSrc) return;

    document.querySelectorAll<HTMLElement>('.set-row .set-frame:not([hidden])').forEach((open) => {
      open.hidden = true;
      open.innerHTML = '';
    });
    frame.innerHTML = `<iframe class="player-frame" src="${row.dataset.embedSrc}" allow="autoplay" title="SoundCloud-Player"></iframe>`;
    frame.hidden = false;
  });
</script>
