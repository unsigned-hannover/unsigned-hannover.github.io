---
// DSGVO: der SoundCloud-Player wird erst beim Klick auf Play geladen (kein automatischer Drittanbieter-Request).
// Bis dahin ist die Oszilloskop-Grafik rein dekorativ (Canvas, keine Daten, kein Request).
interface Props {
  title: string;
  soundcloudUrl: string;
  episodeNumber?: string;
}

const { title, soundcloudUrl, episodeNumber = 'EP.01' } = Astro.props;
const embedSrc = `https://w.soundcloud.com/player/?url=${encodeURIComponent(soundcloudUrl)}&color=%23f25e0d&auto_play=true`;
---

<div class="player hud" data-embed-src={embedSrc}>
  <div class="scope-area">
    <canvas class="scope" width="600" height="110"></canvas>
    <div class="player-meta">
      <span>WAVEFORM // VORSCHAU</span>
      <span>SOUNDCLOUD · NICHT GELADEN</span>
    </div>
  </div>

  <div class="player-title"><b>{episodeNumber}</b> — {title}</div>

  <div class="transport">
    <button type="button" class="play" aria-label={`${title} laden und abspielen`}>▶</button>
    <span class="fmt">QUELLE: SOUNDCLOUD<br />STATUS: KLICK ZUM LADEN</span>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.player[data-embed-src]').forEach((wrapper) => {
    const canvas = wrapper.querySelector<HTMLCanvasElement>('canvas.scope');
    const ctx = canvas?.getContext('2d');
    const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let raf = 0;

    function drawScope(t: number) {
      if (!ctx || !canvas) return;
      const W = canvas.width;
      const H = canvas.height;
      ctx.clearRect(0, 0, W, H);
      ctx.strokeStyle = 'rgba(242,94,13,0.22)';
      ctx.lineWidth = 1;
      for (let gx = 0; gx < W; gx += 20) {
        ctx.beginPath();
        ctx.moveTo(gx, 0);
        ctx.lineTo(gx, H);
        ctx.stroke();
      }

      ctx.beginPath();
      ctx.strokeStyle = '#f25e0d';
      ctx.lineWidth = 2;
      for (let x = 0; x < W; x += 2) {
        const n = Math.sin(x * 0.045 + t * 0.0016) * 0.5 + Math.sin(x * 0.12 + t * 0.003) * 0.25 + (Math.random() - 0.5) * 0.12;
        const y = H / 2 + n * H * 0.38;
        if (x === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.stroke();

      ctx.beginPath();
      ctx.strokeStyle = 'rgba(255,176,32,0.55)';
      ctx.lineWidth = 1;
      for (let x2 = 0; x2 < W; x2 += 2) {
        const n2 = Math.sin(x2 * 0.045 + t * 0.0016 + 0.6) * 0.5 + Math.sin(x2 * 0.09 - t * 0.002) * 0.2;
        const y2 = H / 2 + n2 * H * 0.34;
        if (x2 === 0) ctx.moveTo(x2, y2);
        else ctx.lineTo(x2, y2);
      }
      ctx.stroke();
    }

    function loop(t: number) {
      drawScope(t);
      if (!reduceMotion) raf = requestAnimationFrame(loop);
    }
    if (!reduceMotion) raf = requestAnimationFrame(loop);
    else drawScope(0);

    wrapper.querySelector('.play')?.addEventListener('click', () => {
      cancelAnimationFrame(raf);
      const src = wrapper.dataset.embedSrc;
      if (!src) return;
      const scopeArea = wrapper.querySelector('.scope-area');
      if (scopeArea) {
        scopeArea.outerHTML = `<iframe class="player-frame" src="${src}" loading="lazy" allow="autoplay"></iframe>`;
      }
    });
  });
</script>
