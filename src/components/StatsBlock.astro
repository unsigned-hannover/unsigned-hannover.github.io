---
import { getEntry } from 'astro:content';

const stats = await getEntry('stats', 'stats');
const items = [
  { value: String(stats?.data.events ?? ''), label: 'Events geschmissen', id: 'spark1' },
  { value: stats?.data.listeners ?? '', label: 'Radio-Hörer:innen', id: 'spark2' },
  { value: stats?.data.guests ?? '', label: 'Gäste auf der Fläche', id: 'spark3' },
];
---

<div class="stats-grid">
  {
    items.map((item) => (
      <div class="stat hud">
        <div class="num glitch" data-text={item.value}>
          {item.value}
        </div>
        <div class="lbl">{item.label}</div>
        <div class="spark" data-spark></div>
      </div>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-spark]').forEach((el) => {
    let html = '';
    const n = 24;
    for (let i = 0; i < n; i++) {
      const h = 20 + Math.floor(Math.random() * 80);
      html += `<i style="height:${h}%"></i>`;
    }
    el.innerHTML = html;
  });
</script>
