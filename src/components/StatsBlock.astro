---
import { getEntry } from 'astro:content';

const stats = await getEntry('stats', 'stats');
const items = [
  { value: stats?.data.events, label: 'Events' },
  { value: stats?.data.listeners, label: 'Hörer:innen' },
  { value: stats?.data.guests, label: 'Gäste' },
];
---

<div class="grid grid-cols-3 gap-4 text-center">
  {
    items.map((item) => (
      <div>
        <p class="text-3xl font-extrabold sm:text-4xl" style="color: var(--fg-band)">{item.value}</p>
        <p class="label-mono mt-1 text-xs font-semibold uppercase tracking-wide opacity-70 sm:text-sm" style="color: var(--fg-band)">{item.label}</p>
      </div>
    ))
  }
</div>
