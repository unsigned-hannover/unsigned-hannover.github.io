---
// Sendet an den eigenen Cloudflare-Worker-Mail-Relay (siehe worker/README.md).
// Kein Drittanbieter-Formularservice -> kein AVV nötig, keine dauerhafte Speicherung der Daten.
interface Props {
  formType: 'contact' | 'membership';
  heading: string;
  intro?: string;
}

const { formType, heading, intro } = Astro.props;
const formId = `form-${formType}`;
---

<div class="term-form hud">
  <h3>{heading}</h3>
  {intro && <p class="intro">{intro}</p>}

  <form id={formId} data-form-type={formType}>
    <label for={`${formId}-name`}>Name</label>
    <input id={`${formId}-name`} name="name" type="text" required />

    <label for={`${formId}-email`}>E-Mail</label>
    <input id={`${formId}-email`} name="email" type="email" required />

    {
      formType === 'membership' && (
        <fieldset>
          <legend>Mitgliedschaft</legend>
          <label class="radio-option">
            <input type="radio" name="membershipType" value="ordentlich" checked class="accent-brand" />
            Ordentliches Mitglied
          </label>
          <label class="radio-option">
            <input type="radio" name="membershipType" value="foerdernd" class="accent-brand" />
            Förderndes Mitglied
          </label>
        </fieldset>
      )
    }

    <label for={`${formId}-message`}>Nachricht</label>
    <textarea id={`${formId}-message`} name="message" rows="4" required></textarea>

    <!-- Honeypot: für Menschen unsichtbar, Bots füllen es meist aus -> einfache Spam-Filterung ohne Captcha -->
    <div hidden aria-hidden="true">
      <label for={`${formId}-company`}>Firma</label>
      <input id={`${formId}-company`} name="company" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <label class="consent">
      <input type="checkbox" required class="accent-brand" style="margin-top:2px;" />
      <span>
        Ich habe die <a href="/datenschutzerklaerung/">Datenschutzerklärung</a> gelesen und bin mit der Verarbeitung meiner Daten zur Bearbeitung meiner Anfrage einverstanden.
      </span>
    </label>

    <button type="submit">Absenden →</button>

    <p class="form-status" role="status"></p>
  </form>
</div>

<script>
  const FORM_ENDPOINT = import.meta.env.PUBLIC_FORM_ENDPOINT || '';

  document.querySelectorAll<HTMLFormElement>('form[data-form-type]').forEach((form) => {
    const status = form.querySelector<HTMLParagraphElement>('.form-status');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!FORM_ENDPOINT) {
        if (status) status.textContent = '> Formular ist noch nicht verbunden. Bitte per E-Mail an unsignedhannover@gmail.com wenden.';
        return;
      }

      const data = Object.fromEntries(new FormData(form).entries());
      if (data.company) return; // Honeypot ausgefüllt -> stiller Abbruch

      if (button) button.disabled = true;
      if (status) status.textContent = '> Wird gesendet …';

      try {
        const response = await fetch(FORM_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ formType: form.dataset.formType, ...data }),
        });
        if (!response.ok) throw new Error('Request failed');
        if (status) status.textContent = '> Danke! Wir melden uns bei dir.';
        form.reset();
      } catch {
        if (status) status.textContent = '> Senden fehlgeschlagen. Bitte versuch es erneut oder schreib uns direkt eine E-Mail.';
      } finally {
        if (button) button.disabled = false;
      }
    });
  });
</script>
